# ── OpenAI（必須: Embedding + LLM）────────────────────
OPENAI_API_KEY=sk-...

# ── Google Gemini（Gemini使用時のみ）─────────────────
GOOGLE_API_KEY=AIza...

# ── Upstash Vector（必須）────────────────────────────
# https://console.upstash.com → Vector → Create Index
# Dimensions: 1536 / Metric: COSINE
UPSTASH_VECTOR_REST_URL=https://xxx.upstash.io
UPSTASH_VECTOR_REST_TOKEN=AXxx...

# ── Upstash Redis（任意: レート制限。未設定なら無制限）──
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_PUBLIC=30
RATE_LIMIT_INVITED=30

# ── 招待コード（任意: カンマ区切り。画面からのガイド追加にも必要）──
INVITE_CODES=

# ── 管理者トークン（任意: /api/ingest をスクリプトから呼ぶ場合）──
INGEST_TOKEN=

# ── 定期実行の確認（任意: 設定すると /api/keepalive は Vercel Cron からだけ呼べる）──
CRON_SECRET=
